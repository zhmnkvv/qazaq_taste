# Copy this file to .env and fill in your values. Never commit .env!
#   PowerShell:  Copy-Item .env.example .env

# Telegram bot token from @BotFather (required to run the bot, not needed for tests)
BOT_TOKEN=

# Local Ollama server and model (free, runs on your computer)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=90
OLLAMA_TEMPERATURE=0.4
# Context window in tokens: the system prompt + menu take ~8k tokens, the rest is dialogue history
OLLAMA_NUM_CTX=16384

# How many previous messages the AI remembers per user (keep small for local models)
AI_HISTORY_LIMIT=10
AI_MAX_INPUT_CHARS=1000

# SQLite database (file is git-ignored)
DATABASE_URL=sqlite:///data/qazaq_taste.db

# Confirmed booking requests from the chat (JSON) flow; git-ignored, contains personal data
BOOKINGS_CSV=bookings.csv

# Print the <размышление> block of AI replies to the console (it is never sent to Telegram)
SHOW_REASONING=true

# Only for the manual comparison script scripts/openrouter_compare.py (reasoning ON vs OFF).
# The bot itself keeps using local Ollama. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

TIMEZONE=Asia/Almaty

# Optional: Telegram chat id that receives new booking/event requests
ADMIN_CHAT_ID=

LOG_LEVEL=INFO
